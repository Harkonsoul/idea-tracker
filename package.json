{
  "name": "idea-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "Idea Tracker — take-home assignment (ASP.NET Core API + React/TypeScript SPA)",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "dotnet run --project backend/src/IdeaTracker.Api",
    "dev:web": "npm --prefix frontend run dev",
    "install:web": "npm --prefix frontend install",
    "build:web": "npm --prefix frontend run build",
    "test:web": "npm --prefix frontend run test",
    "test:api": "dotnet test backend/IdeaTracker.sln"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
